{
  "id": "demo-side-project",
  "version": "2.0",
  "name": "Demo Login Test",
  "url": "https://the-internet.herokuapp.com",
  "tests": [
    {
      "id": "test-001",
      "name": "Login Test",
      "commands": [
        {
          "id": "cmd-001",
          "comment": "Open the login page",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-002",
          "comment": "Set window size",
          "command": "setWindowSize",
          "target": "1280x800",
          "targets": [],
          "value": ""
        },
        {
          "id": "cmd-003",
          "comment": "Enter username",
          "command": "type",
          "target": "id=username",
          "targets": [
            ["id=username", "id"],
            ["css=#username", "css:finder"],
            ["xpath=//input[@id='username']", "xpath:attributes"]
          ],
          "value": "${USERNAME}"
        },
        {
          "id": "cmd-004",
          "comment": "Enter password",
          "command": "type",
          "target": "id=password",
          "targets": [
            ["id=password", "id"],
            ["css=#password", "css:finder"],
            ["xpath=//input[@id='password']", "xpath:attributes"]
          ],
          "value": "${PASSWORD}"
        },
        {
          "id": "cmd-005",
          "comment": "Click login button",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [
            ["css=button[type='submit']", "css:finder"],
            ["xpath=//button[@type='submit']", "xpath:attributes"]
          ],
          "value": ""
        },
        {
          "id": "cmd-006",
          "comment": "Wait for dashboard to load",
          "command": "waitForElementVisible",
          "target": "css=.flash.success",
          "targets": [],
          "value": "5000"
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "suite-001",
      "name": "Auth Suite",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
      "tests": ["test-001"]
    }
  ],
  "urls": ["https://the-internet.herokuapp.com"],
  "plugins": []
}
