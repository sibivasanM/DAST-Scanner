# ─── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit .env to version control

# ─── OpenAI (required for AI analysis) ───────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── OWASP ZAP ────────────────────────────────────────────────────────────────
# Change this to a strong random string in production
ZAP_API_KEY=change-me-strong-random-key

# ZAP scan limits
ZAP_SPIDER_DURATION=10
ZAP_SCAN_DURATION=60

# ─── CORS (comma-separated origins, or * for development only) ────────────────
# Production: CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# ─── Scanning ─────────────────────────────────────────────────────────────────
MAX_CONCURRENT_SCANS=3

# Set to false to skip Nuclei template update on every scan (faster)
NUCLEI_AUTO_UPDATE=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=/app/data/vulnforge.db

# ─── Optional: NVD API key (higher rate limits for CVE lookup) ────────────────
# Get free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
